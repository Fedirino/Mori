{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.hosting-only.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "CHANGELOG.md",
      "SETUP.md",
      "AGENTS.md",
      "mockups/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/lights/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/lights/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/lights/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
